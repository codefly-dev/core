{
  "schema": "codefly/coordinate/v1",
  "environment": {
    "name": "staging",
    "namespace": "product",
    "cluster": {"kind": "external", "context": "shared-test"},
    "service-config": {
      "services": {
        "api": {
          "values": {
            "DATABASE_HOST": "product-staging.database.example",
            "DATABASE_PORT": "6432"
          }
        },
        "worker": {
          "values": {"DATABASE_HOST": "product-staging.database.example"}
        }
      }
    },
    "service-secrets": {
      "secret-store": {"name": "app-secrets", "kind": "SecretStore"},
      "services": {
        "api": {"remote-keys": {"DATABASE_PASSWORD": {"key": "product/api", "property": "password"}}}
      }
    }
  }
}
