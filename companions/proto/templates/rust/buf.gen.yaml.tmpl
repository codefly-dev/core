version: v2
plugins:
  # The companion pins both local plugins to 0.5.0, targeting tonic/prost 0.14
  # (codec via the separate `tonic-prost` crate). Local execution preserves
  # descriptor-set target selection for imported message types.
  #
  # NOT compile_well_known_types: that makes prost emit RELATIVE paths for
  # google.protobuf.* (`super::super::google::…`) which assume one exact module
  # nesting and break under any include layout. The default (extern paths to the
  # `prost-types` crate — `::prost_types::Timestamp`, and `Empty` → `()`) is
  # layout-independent, so the consuming crate just depends on `prost-types`.
  - local: protoc-gen-prost
    out: {{.Destination}}
    strategy: all
    include_imports: {{.IncludeImports}}
  - local: protoc-gen-tonic
    out: {{.Destination}}
    strategy: all
    include_imports: {{.IncludeImports}}
    opt:
      - no_server
