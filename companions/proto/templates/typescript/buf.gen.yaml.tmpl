version: v1
plugins:
  # The companion's own protoc-gen-es, not buf.build/bufbuild/es over the
  # network. The image bakes one version, pinned from source and held to the
  # ecosystem runtime by companion_plugins_test.go; a remote plugin carries a
  # second pin that nothing keeps in step, so the bindings a consumer generates
  # and the @bufbuild/protobuf it runs them against drift apart.
  #
  # It is also what makes the image's import markers mean anything: remote
  # execution generated the marked namespaces anyway, so a library got local
  # copies of google/api and buf/validate whether or not it was owed them. See
  # MarkForeignImports.
  - name: es
    out: {{.Destination}}
    opt: target=ts
{{- if .Facade }}
  - name: codefly-facade-ts
    out: {{.Destination}}
    # The facade reads the whole descriptor (grouping services by package,
    # validating services=), so buf must run it once over every file — not with
    # its default per-directory strategy, which would hide services in other
    # directories from each invocation.
    strategy: all
    opt: target=ts{{ if .Services }},services={{.Services}}{{ end }}{{ if .Module }},module={{.Module}}{{ end }}
{{- end }}
