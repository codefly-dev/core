version: v1
managed:
  enabled: true
  go_package_prefix:
    default: {{.GoPackagePrefix}}
    except:
      - buf.build/googleapis/googleapis
      - buf.build/bufbuild/protovalidate
{{- if .GoPackageOverrides }}
  # `except` above matches by buf module identity, which a plain
  # FileDescriptorSet does not carry, so it is inert on the descriptor-set path.
  # These per-file overrides pin the go_package each foreign import declares, so
  # the module's bindings reference the canonical upstream package instead of a
  # local copy that would collide with it in the descriptor pool.
  override:
    GO_PACKAGE:
{{- range $path, $pkg := .GoPackageOverrides }}
      "{{ $path }}": "{{ $pkg }}"
{{- end }}
{{- end }}
plugins:
  - name: go
    out: {{.Destination}}
    opt: paths=source_relative
{{- if .Facade }}
  - name: connect-go
    out: {{.Destination}}
    opt: paths=source_relative
  - name: codefly-facade-go
    out: {{.Destination}}
    # The facade reads the whole descriptor (grouping services by package,
    # validating services=), so buf must run it once over every file — not with
    # its default per-directory strategy, which would hide services in other
    # directories from each invocation.
    strategy: all
    opt: paths=source_relative{{ if .Services }},services={{.Services}}{{ end }}{{ if .Module }},module={{.Module}}{{ end }}
{{- else }}
  - name: go-grpc
    out: {{.Destination}}
    opt: paths=source_relative
  - name: openapiv2
    out: {{.Destination}}/../openapi
    opt: logtostderr=true
    path: protoc-gen-openapiv2
{{- end }}
