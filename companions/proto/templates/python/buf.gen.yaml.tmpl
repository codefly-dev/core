version: v1
# The companion's local plugin, as Go's are: the *_pb2 messages and *_pb2_grpc
# stubs compiled by the grpc_tools pinned in the image, so the gencode is the
# image's. buf's remote python plugins moved on their own and outran the
# protobuf runtime a generated library declares.
plugins:
  - name: codefly-python
    out: {{.Destination}}
{{- if .Facade }}
  - name: codefly-facade-python
    out: {{.Destination}}
    # The facade reads the whole descriptor (grouping services by package,
    # validating services=), so buf must run it once over every file — not with
    # its default per-directory strategy, which would hide services in other
    # directories from each invocation.
    strategy: all
{{- if or .Services .Module }}
    opt: {{ if .Services }}services={{.Services}}{{ end }}{{ if and .Services .Module }},{{ end }}{{ if .Module }}module={{.Module}}{{ end }}
{{- end }}
{{- end }}
