# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and agents
*.exe
*.exe~
*.dll
*.so
*.dylib

# Hash/cache
*.hash

# Machine-local module-resolver overlay (identity is committed, location is not)
codefly.local.yaml

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Test coverage
cover.out

__pycache__
dist

.token

bin
companions/treesitter/typescript/

# Local build artifacts from running toolbox/launch demos
network-victim-toolbox

# `go build ./internal/corepindrift` writes its binary here, named after the
# package. One was committed in #893 (10MB) because `git add -A` swept it up.
# Run the checker with `go run ./internal/corepindrift` or `make check-core-pin`.
corepindrift

# Rust build artifacts
/target/
